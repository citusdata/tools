[MASTER]

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    invalid-name,
    too-few-public-methods,
    duplicate-code,
    wrong-import-order,
    too-many-instance-attributes,
    too-many-arguments,
    too-many-branches,
    too-many-locals,
    too-many-statements,
    line-too-long,
    redefined-outer-name,
    fixme,
    ungrouped-imports

[FORMAT]
max-line-length=160
